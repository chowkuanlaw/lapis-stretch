{
  "name": "lapis",
  "productName": "Lapis",
  "version": "1.11.2",
  "description": "Lapis stretch reminder: desk stretch nudges with a desktop widget and pop-up reminders",
  "main": "main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chowkuanlaw/lapis-stretch.git"
  },
  "homepage": "https://github.com/chowkuanlaw/lapis-stretch#readme",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:installer": "electron-builder --win nsis --x64 --publish never",
    "dist:portable": "bash scripts/build-win.sh",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "app.lapis.stretch",
    "productName": "Lapis",
    "electronLanguages": ["en-US", "ms"],
    "copyright": "Copyright (c) 2026 chowkuanlaw",
    "directories": {
      "output": "dist/installer"
    },
    "files": [
      "main.js",
      "quiet.js",
      "state.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "Lapis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lapis",
      "deleteAppDataOnUninstall": false,
      "include": "installer/uninstall.nsh",
      "artifactName": "Lapis-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chowkuanlaw",
        "repo": "lapis-stretch",
        "releaseType": "release"
      }
    ]
  }
}
